# C5VRX P4 display (docs/P4LINK.md): Guition JC1060P470C, ESP-IDF 5.5.
CONFIG_IDF_TARGET="esp32p4"
# The board's P4 is an early revision (as the vendor example).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# USB webcam: MJPEG 800x600 only, on the high-speed port.
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_FORMAT_MJPEG_CAM1=y
CONFIG_FRAMESIZE_SVGA=y
CONFIG_UVC_CAM1_FRAMERATE=30
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=n
CONFIG_TUSB_MANUFACTURER="C5VRX"
CONFIG_TUSB_PRODUCT="C5VRX Receiver"
# The JPEG encoder writes its input back from the cache in one critical
# section; in 32 KB pieces the other tasks get in between (as p4usb).
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS=y
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS_MAX_LEN=0x8000
