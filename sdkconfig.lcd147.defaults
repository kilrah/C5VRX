# Waveshare ESP32-C5-LCD-1.47 (docs/LCD147.md), on top of sdkconfig.defaults:
#   idf.py -B build-lcd147 -DSDKCONFIG=sdkconfig.lcd147 \
#     "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.lcd147.defaults" build
# The picture and the menu go to the board's ST7789 LCD; the DAC (5 or 6
# bits, menu DAC) to header pins.
CONFIG_C5VRX_BOARD_WAVESHARE_LCD147=y
# ESP32-C5FH4: 4 MB of in-package flash, no PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
# Per-task CPU shares on the console T line (LCD tasks): the grabber takes
# whatever the receiver tasks leave, so the bench needs to see that share.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
